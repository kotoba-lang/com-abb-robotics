(ns abb-robotics.paginate
  (:export [as-int clamp-limit has-more? main test-clamp-limit]))

;; Bounded pure-int slice of abb_robotics.main/paginate: the pagination
;; *decision* kernel only. The .cljc `paginate` stays authoritative for cursor
;; walking over rows (string ids, `starting_after`); what migrates here is the
;; pure integer decision the handler makes after the rows are cut: coerce the
;; requested limit, clamp it, and decide whether another page exists.
;; No strings, no maps, no folds -- the same subset page_limit.kotoba lives in.

(def default-limit 20)
(def max-limit 100)

;; Positive-int coercion of an untrusted page-size input. The .cljc `as-int`
;; accepts strings and maps to 0 on failure; that parse half stays on the
;; oracle (strings are outside the admitted subset). Once a caller has an
;; integer, this is its value shape: non-positive collapses to 0.
(defn as-int [v]
  (if (> v 0) v 0))

;; Clamp a coerced page size into [1, max-limit]; 0 (absent) -> default-limit.
(defn clamp-limit [requested]
  (if (> requested 0)
    (if (> requested max-limit) max-limit requested)
    default-limit))

;; The `has_more` decision of handle-list: the row supply outgrew the page
;; when the remaining count strictly exceeds the applied limit.
(defn has-more? [remaining limit]
  (if (> remaining limit) 1 0))

(defn main []
  (has-more? 101 (clamp-limit (as-int 100))))

(defn test-clamp-limit []
  (and (= (clamp-limit 0) 20)
       (= (clamp-limit 250) 100)
       (= (clamp-limit 50) 50)))
